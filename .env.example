# Supabase — same project as the website (see elev repo's SUPABASE_SETUP.md)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — SERVER ONLY. Bypasses RLS for admin writes + image uploads.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public storage bucket for blog images.
SUPABASE_STORAGE_BUCKET=blog-images
